# Copy this file to .env and fill it in:  cp .env.example .env

PORT=3112
NODE_ENV=production
PUBLIC_URL=https://office.medialinkers.pk

# Long random text (at least 32 characters) that signs login sessions.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, the app creates a random one in data/.session_secret (also safe).
# Changing it later signs everyone out.
JWT_SECRET=

# Office clock. Fines and dates follow this time zone, wherever the server is.
TZ=Asia/Karachi

# Admin password (at least 8 characters). It is applied on start, and again every time you
# change it here and restart (pm2 restart office-attendance). Changing it in Settings also works.
# If empty or shorter than 8, a random one is saved in data/FIRST_ADMIN_PASSWORD.txt on the first start.
# Forgot it? On the server run:  npm run reset-admin -- "NewPassword123"
ADMIN_PASSWORD=

# Push notification keys. Leave empty: the app creates them once and saves them in data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# The app listens on 127.0.0.1 only (Nginx talks to it). Don't change unless you use Docker.
# HOST=127.0.0.1

# Which proxy may pass the visitor's real IP (X-Forwarded-For). Default: Nginx on this server only.
# TRUST_PROXY=loopback

# Behind Cloudflare (orange cloud)? Read the real IP from Cloudflare's header instead.
# Only do this if the server accepts traffic from Cloudflare only.
# IP_HEADER=cf-connecting-ip
